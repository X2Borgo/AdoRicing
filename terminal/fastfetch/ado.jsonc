{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ado.png",
    "type": "auto",
    "height": 16,
    "width": 32,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " ➜ ",
    "color": {
      "separator": "cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "keyColor": "blue"
    },
    "break",

    // --- SYSTEM (Blue) ---
    // Added Packages and Disk here
    {
      "type": "os",
      "key": "💙 SYSTEM ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│ ├ ⚙️",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├ 📦",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "│ ├ 💾",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "│ └ ⏳",
      "keyColor": "blue"
    },

    // --- DESKTOP (Cyan) ---
    // Used DE as the header, moved WM inside
    {
      "type": "de",
      "key": "🦋 DESKTOP",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "│ ├ 🪟",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "│ ├ 🐚",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│ ├ 📟",
      "keyColor": "cyan"
    },
    {
      "type": "wmtheme",
      "key": "│ └ 🎨",
      "keyColor": "cyan"
    },

    // --- HARDWARE (Magenta) ---
    // Added Battery at the end
    {
      "type": "host",
      "key": "💜 HARDWARE",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "│ ├ 🧠",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "│ ├ 🎮",
      "format": "{2}",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "│ ├ 🐏",
      "keyColor": "magenta"
    },
    {
      "type": "battery",
      "key": "│ └ 🔋",
      "keyColor": "magenta"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 6
    }
  ]
}