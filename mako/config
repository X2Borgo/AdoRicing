# Ado Hibana theme for mako
# Only used on the Waybar fallback path — DMS owns notifications when running
# (see hypr/scripts/LaunchShell.sh).

font=JetBrainsMono Nerd Font 11
background-color=#0f152eee
text-color=#c0c0c0
border-color=#00f0ff
progress-color=over #d000ff

width=380
height=140
margin=12
padding=12,14
border-size=2
border-radius=10

anchor=top-right
layer=overlay
max-visible=5
sort=-time
default-timeout=6000
icons=1
max-icon-size=48

[urgency=low]
border-color=#4d556d
default-timeout=4000

[urgency=critical]
border-color=#ff4d4d
text-color=#ffe066
default-timeout=0

[app-name=Spotify]
border-color=#00e0b0

[mode=do-not-disturb]
invisible=1
